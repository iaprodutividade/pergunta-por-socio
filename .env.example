# Groq (transcrição de áudio - Whisper)
GROQ_API_KEY=

# OpenAI (interpretação da pergunta + resposta em texto)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Postgres do Mural Financeiro (role mural_socio_readonly, só SELECT nas views)
MURAL_DB_HOST=
MURAL_DB_PORT=5432
MURAL_DB_NAME=
MURAL_DB_USER=mural_socio_readonly
MURAL_DB_PASSWORD=
MURAL_DB_SSL=true

# Segredo pra assinar os links mágicos (gerar um valor aleatório longo, nunca reaproveitar)
TOKEN_SECRET=

# Base URL pública do app, usada só pelo script de geração de link
BASE_URL=https://socios.plataformafacil.com.br

PORT=3200
